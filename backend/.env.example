PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Banking rules
DEFAULT_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
# Set to false to make deposits staff-only (customers can top up their own accounts while there is no payment gateway)
ALLOW_CUSTOMER_DEPOSITS=true

# Only used by `npm run seed:admin` to create (or promote) the first admin account
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

